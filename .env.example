# ===================== NEXUS / QuantumX v1.0 =====================
# Copy to .env for local use. On Render put these in Environment.

APP_NAME=NEXUS
DATABASE_URL=sqlite:///./data/nexus.db

# ---------- AssemblyAI (hackathon mode: real-time voice) ----------
ASSEMBLYAI_API_KEY=
# Model per spoken language. Check AssemblyAI docs if a model name changes.
ASSEMBLYAI_MODEL_EN=universal-3-5-pro
ASSEMBLYAI_MODEL_HI=universal-3-5-pro
ASSEMBLYAI_MODEL_GU=whisper-rt
ASSEMBLYAI_TOKEN_TTL=120

# ---------- Free LLM providers (personal mode + also the brain in hackathon mode) ----------
# Order used by the router. First that is configured is tried first, next ones are fallbacks.
LLM_PROVIDERS=gemini,groq,openrouter
GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-latest
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openai/gpt-oss-120b:free
OPENROUTER_SITE_URL=http://localhost:8000
OPENROUTER_APP_NAME=NEXUS

# ---------- Free voice input (personal mode, push-to-talk) ----------
# Uses Groq Whisper. Needs GROQ_API_KEY above.
GROQ_STT_MODEL=whisper-large-v3-turbo

# ---------- Orchestrator limits (protect your free-tier quota) ----------
MAX_HISTORY_MESSAGES=30
MAX_ITERATIONS=3
MAX_AGENT_CALLS=8
MAX_STEP_RETRIES=1
AGENT_TIMEOUT=45
REQUEST_DEADLINE=75
# auto = re-check goal only when something failed | always | never
GOAL_CHECK=auto

# ---------- Safety ----------
RATE_LIMIT_PER_MIN=40
CORS_ORIGINS=*
ENABLE_CODE_EXECUTION=false
CODE_EXEC_TIMEOUT=4
=======
# ---------------- MODE / PROVIDERS ----------------
DEFAULT_MODE=personal

# LLM provider:
# mock           -> no external LLM required; useful for UI smoke tests
# openai_compat  -> any OpenAI-compatible /v1 chat/completions endpoint
AOB_LLM_PROVIDER=mock
OPENAI_COMPAT_BASE_URL=https://api.openai.com/v1
OPENAI_COMPAT_API_KEY=
OPENAI_COMPAT_MODEL=

# ---------------- ASSEMBLYAI ----------------
ASSEMBLYAI_API_KEY=
ASSEMBLYAI_SPEECH_MODEL=universal-3-5-pro
ASSEMBLYAI_MODE=balanced
ASSEMBLYAI_SAMPLE_RATE=16000
ASSEMBLYAI_MIN_TURN_SILENCE=160
ASSEMBLYAI_MAX_TURN_SILENCE=2400
ASSEMBLYAI_MIN_CONFIDENCE=0.50

# ---------------- PERSONAL VOICE ----------------
# Uses optional local faster-whisper package.
PERSONAL_STT_MODEL=small
PERSONAL_STT_LANGUAGE=
PERSONAL_STT_DEVICE=cpu
PERSONAL_STT_COMPUTE_TYPE=int8
PERSONAL_RECORD_SECONDS=12

# ---------------- TTS ----------------
# pyttsx3 is local/offline on supported desktop environments.
TTS_ENABLED=true
TTS_RATE=185
TTS_VOLUME=1.0

# ---------------- HISTORY ----------------
HISTORY_FILE=data/history.json
HISTORY_MAX_TURNS=40
