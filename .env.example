# --- App ---
APP_NAME=NEXUS
DATABASE_URL=sqlite:///./data/nexus.db

# --- AssemblyAI ---
ASSEMBLYAI_API_KEY=
ASSEMBLYAI_STREAM_MODEL=u3-rt-pro
ASSEMBLYAI_TOKEN_TTL=120

# --- LLM ---
# gemini | openrouter | mock
LLM_PROVIDER=gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
OPENROUTER_API_KEY=
OPENROUTER_MODEL=google/gemini-2.5-flash
OPENROUTER_SITE_URL=http://localhost:8000
OPENROUTER_APP_NAME=NEXUS

# --- Safety / execution ---
ENABLE_CODE_EXECUTION=false
CODE_EXEC_TIMEOUT=4
MAX_HISTORY_MESSAGES=30
