# ---------------- MODE / PROVIDERS ----------------
DEFAULT_MODE=personal

# LLM provider:
# mock           -> no external LLM required; useful for UI smoke tests
# openai_compat  -> any OpenAI-compatible /v1 chat/completions endpoint
AOB_LLM_PROVIDER=mock
OPENAI_COMPAT_BASE_URL=https://api.openai.com/v1
OPENAI_COMPAT_API_KEY=
OPENAI_COMPAT_MODEL=

# ---------------- ASSEMBLYAI ----------------
ASSEMBLYAI_API_KEY=
ASSEMBLYAI_SPEECH_MODEL=universal-3-5-pro
ASSEMBLYAI_MODE=balanced
ASSEMBLYAI_SAMPLE_RATE=16000
ASSEMBLYAI_MIN_TURN_SILENCE=160
ASSEMBLYAI_MAX_TURN_SILENCE=2400
ASSEMBLYAI_MIN_CONFIDENCE=0.50

# ---------------- PERSONAL VOICE ----------------
# Uses optional local faster-whisper package.
PERSONAL_STT_MODEL=small
PERSONAL_STT_LANGUAGE=
PERSONAL_STT_DEVICE=cpu
PERSONAL_STT_COMPUTE_TYPE=int8
PERSONAL_RECORD_SECONDS=12

# ---------------- TTS ----------------
# pyttsx3 is local/offline on supported desktop environments.
TTS_ENABLED=true
TTS_RATE=185
TTS_VOLUME=1.0

# ---------------- HISTORY ----------------
HISTORY_FILE=data/history.json
HISTORY_MAX_TURNS=40
