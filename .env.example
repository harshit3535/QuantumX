# ===================== Astra / QuantumX v2.8 =====================
# Copy to .env for local use. On Render put these in Environment.

APP_NAME=ASTRA
DATABASE_URL=sqlite:///./data/nexus.db

# ---------- AssemblyAI (hackathon mode: real-time voice) ----------
ASSEMBLYAI_API_KEY=
# Model per spoken language. Check AssemblyAI docs if a model name changes.
ASSEMBLYAI_MODEL_EN=universal-3-5-pro
ASSEMBLYAI_MODEL_HI=universal-3-5-pro
ASSEMBLYAI_MODEL_GU=whisper-rt
ASSEMBLYAI_TOKEN_TTL=120

# ---------- Free LLM providers (personal mode + also the brain in hackathon mode) ----------
# Order used by the router. First that is configured is tried first, next ones are fallbacks.
LLM_PROVIDERS=gemini,groq,openrouter
GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-latest
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openai/gpt-oss-120b:free
OPENROUTER_SITE_URL=http://localhost:8000
OPENROUTER_APP_NAME=ASTRA

# ---------- Free voice input (personal mode, push-to-talk) ----------
# Uses Groq Whisper. Needs GROQ_API_KEY above.
GROQ_STT_MODEL=whisper-large-v3-turbo

# ---------- Orchestrator limits (protect your free-tier quota) ----------
MAX_HISTORY_MESSAGES=30
MAX_ITERATIONS=3
MAX_AGENT_CALLS=8
MAX_STEP_RETRIES=1
AGENT_TIMEOUT=45
REQUEST_DEADLINE=75
# auto = re-check goal only when something failed | always | never
GOAL_CHECK=auto

# ---------- Safety ----------
RATE_LIMIT_PER_MIN=40
CORS_ORIGINS=*
ENABLE_CODE_EXECUTION=false
CODE_EXEC_TIMEOUT=4

# v2.8 native AssemblyAI Voice Agent
ASSEMBLYAI_VOICE_AGENT=true
ASSEMBLYAI_VOICE=anna
ASSEMBLYAI_VOICE_TOKEN_TTL=300

RECEPTIONIST_ENABLED=true
RECEPTIONIST_BUSINESS_NAME=Astra Front Desk
RECEPTIONIST_TIMEZONE=Asia/Kolkata
RECEPTIONIST_HOURS=Mon-Fri 09:00-17:00
RECEPTIONIST_SLOT_MINUTES=30
RECEPTIONIST_MIN_NOTICE_MINUTES=30
RECEPTIONIST_CONFIRM_REQUIRED=true
MISSION_EVENT_LIMIT=500

# Optional persistent cloud chat memory (recommended for Render free tier)
CLOUD_MEMORY_ENABLED=true
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_SERVICE_ROLE_KEY=YOUR_SERVER_ONLY_SERVICE_ROLE_KEY
SUPABASE_MEMORY_TABLE=astra_memory
